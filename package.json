{
  "name": "dsh-plugin-offwork",
  "version": "0.2.1",
  "description": "下班倒计时 + 今日已赚：侧边栏两张统计卡片，工作日倒计时到点，17:00 后自动变「已加班」红字计时；日薪按月薪÷月工作日换算，周六周日休。设置改 ~/.dsh/offwork.json，60 秒生效不用重启。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "countdown",
    "offwork",
    "sidebar-card"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunaono1/dsh-plugin-offwork.git"
  }
}
