{
  "name": "dsh-plugin-offwork",
  "version": "0.2.1",
  "description": "侧边栏紧凑显示下班倒计时与今日已赚，支持在卡片上自定义上下班时间和日薪。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "countdown",
    "offwork",
    "sidebar-card"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunaono1/dsh-plugin-offwork.git"
  }
}
